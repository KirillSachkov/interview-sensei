{
  "workspaces": {
    ".": {
      "entry": ["tools/*.{ts,mjs}", "tests/**/*.ts", "e2e/**/*.ts"],
      "project": [
        "tools/**/*.ts",
        "tests/**/*.ts",
        "e2e/**/*.ts",
        "*.config.ts"
      ]
    },
    "apps/server": {
      "entry": [
        "src/api.ts",
        "src/worker.ts",
        "src/goal-setup-map.ts",
        "src/modules/*/index.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "apps/web": { "project": ["src/**/*.tsx"] }
  }
}
