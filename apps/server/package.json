{
  "name": "@interview-sensei/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "interview-sensei": "./src/launch.ts"
  },
  "scripts": {
    "build": "node scripts/build-package.ts",
    "dev": "node --watch src/main.ts",
    "lint": "oxlint",
    "boundaries": "depcruise src --output-type err-long",
    "test": "vitest run --project unit --project integration --passWithNoTests",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "test:package": "vitest run --project package"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "11.3.7",
    "@interview-sensei/core": "workspace:*",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "dependency-cruiser": "18.7.0",
    "fflate": "0.8.3",
    "rolldown": "1.2.16",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
